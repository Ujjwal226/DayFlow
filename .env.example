# DayFlow Backend Environment Configuration
# Copy this file to .env and fill in the values.

# Database path (SQLite for local dev; use /mnt/data/dayflow.db on Render)
DATABASE_URL=sqlite:///./data/dayflow.db

# CORS – comma-separated list of allowed origins for the React frontend
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# App environment: development | production
APP_ENV=development
