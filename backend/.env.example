# DayFlow Backend Environment Configuration
# Copy this file to .env and adjust values for your environment.

# Database URL:
# Local development (SQLite):
DATABASE_URL=sqlite:///./data/dayflow.db
# Production (Supabase Free PostgreSQL Tier):
# Transaction Pooler (recommended for serverless/Render):
# DATABASE_URL=postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?sslmode=require
# Or Direct Connection:
# DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres?sslmode=require

# CORS – comma-separated list of allowed frontend origins
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,https://your-dayflow-frontend.onrender.com

# App environment: development | production
APP_ENV=development

# JWT & Authentication Secrets
# In production, generate a secure 32+ character random string (e.g. `openssl rand -hex 32`)
SECRET_KEY=change-this-in-production-to-a-secure-random-secret-key-32chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Default Seed User for Safe Migration of Existing Legacy Tasks (Optional)
DEFAULT_USER_EMAIL=owner@dayflow.app
DEFAULT_USER_PASSWORD=DayFlow2026!
