# Application Configuration
APP_NAME="DayFlow"
APP_ENV="development"
DEBUG=True
SECRET_KEY="replace-this-with-a-secure-random-secret-key-in-production"
API_V1_PREFIX="/api/v1"

# Database Configuration (PostgreSQL 18 via psycopg 3)
DATABASE_URL="postgresql+psycopg://postgres:postgres@localhost:5432/dayflow_db"

# CORS Configuration (JSON array of strings or comma-separated list)
FRONTEND_URL="http://localhost:5173"
BACKEND_CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173"]

