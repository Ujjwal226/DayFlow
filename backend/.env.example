# Application Configuration
APP_NAME="DayFlow"
APP_ENV="development"
DEBUG=True
SECRET_KEY="replace-this-with-a-secure-random-secret-key-in-production"
API_V1_PREFIX="/api/v1"

# Database Configuration (PostgreSQL 18 via psycopg 3)
DATABASE_URL="postgresql+psycopg://postgres:postgres@localhost:5432/dayflow_db"

# CORS Configuration (JSON array of strings or comma-separated list)
FRONTEND_URL="http://localhost:5173"
BACKEND_CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173"]

# Authentication & JWT Configuration
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
REFRESH_COOKIE_NAME="dayflow_refresh_token"
REFRESH_COOKIE_SECURE=False
REFRESH_COOKIE_SAMESITE="lax"
REFRESH_COOKIE_PATH="/api/v1/auth"

# Email Provider Configuration ("development" or "smtp")
EMAIL_PROVIDER="development"
EMAIL_FROM="noreply@dayflow.app"
VERIFICATION_TOKEN_EXPIRE_HOURS=24
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=60

# Rate Limiting Configuration
AUTH_EMAIL_RATE_LIMIT_IP_MAX_REQUESTS=3
AUTH_EMAIL_RATE_LIMIT_IP_WINDOW_MINUTES=15
AUTH_EMAIL_COOLDOWN_PER_EMAIL_MINUTES=2
# In development, the default below can be used. Production MUST configure a unique, secret salt (min 16 chars).
RATE_LIMIT_SALT="replace-with-a-secure-salt-for-rate-limiting-in-production"
# List of trusted reverse proxy IPs/CIDRs whose X-Forwarded-For headers will be honored (JSON array or comma-separated)
TRUSTED_PROXIES=[]
